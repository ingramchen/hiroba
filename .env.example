# Copy to .env before the first `docker compose up`. TOKEN_SECRET has no
# compose default and must come from this file; every other value below is the
# default the compose file already uses.

# signs account and chatter tokens
TOKEN_SECRET=hiroba-dev-token-secret
# signs remote media load requests. The client builds load urls itself, so this
# is served to every visitor; it is a gate, not a secret.
WEB_LOADER_KEY=hiroba-dev-web-loader-key
# hosts the media loader may fetch from, comma separated. Blank keeps the built-in list; when set it REPLACES
# those defaults. A link to any other host still
# works, it just opens in a new tab instead of rendering inline. Addresses
# resolving to private ranges are always refused.
WEB_LOADER_HOSTS=
# admin console password
SYS_PASSWORD=hiroba-dev-sys-password
# how many right-hand x-forwarded-for hops are trusted. 0 means trust none and
# ban by the connecting socket address, which is the safe default: behind a
# proxy that does not forward the client address, every visitor looks like one
# address and a single ban would cover the whole square.
TRUST_PROXY=0

# public origin browsers reach the site on, used to build the google redirect
# uri. Blank leaves google login off; passkeys work regardless.
PUBLIC_ORIGIN=
# google oauth client id, blank leaves google login off; passkeys work regardless
GOOGLE_CLIENT_ID=
# google oauth client secret
GOOGLE_CLIENT_SECRET=
# set to 1 to open /api/dev/login, which mints an account session for any
# local caller without google. For development and tests only; never set it on
# a deployment anyone else can reach. The image runs with NODE_ENV=production,
# which keeps dev login closed whatever DEV_LOGIN says; for a development
# compose set NODE_ENV=development as well.
DEV_LOGIN=
# node environment; only "development" lets DEV_LOGIN=1 take effect
NODE_ENV=

# any S3 compatible endpoint
S3_ENDPOINT=http://minio:9000
# storage region, blank for MinIO (then us-east-1)
S3_REGION=
# storage access key
S3_ACCESS_KEY=hirobaminio
# storage secret key
S3_SECRET_KEY=hirobaminio
# bucket for uploaded images
S3_BUCKET_IMG=hiroba-img
# bucket for cached remote media
S3_BUCKET_C=hiroba-c
# bucket for converted videos
S3_BUCKET_V=hiroba-v

# id generator node number
FLAKE_NODE_ID=1
# cache directory for loaded media; unset keeps nothing on disk
WEB_LOADER_CACHE_PATH=/data/web-loader-cache
# zone the nightly maintenance jobs and the console charts read their clock in;
# blank means UTC. example:
SCHEDULE_TIME_ZONE=Asia/Taipei
# largest single upload accepted, in megabytes; blank or a
# value it cannot use keeps 25
UPLOAD_LIMIT_MB=
# image classifier base url; unset or `naive` uses the
# built-in reference classifier outside production
IMGMOD_URL=
# bearer token sent to the image classifier
IMGMOD_TOKEN=

