{
  "name": "hiroba",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "lint:types": "oxlint --type-aware -c .oxlintrc.type-aware.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm -r build && pnpm -r typecheck && pnpm lint && pnpm lint:types && pnpm format:check"
  },
  "devDependencies": {
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "wrangler": "4.131.0"
  }
}
